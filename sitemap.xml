<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sitemap for carbonfootball.uk
  book.html is intentionally omitted — it is a gated funnel terminal that
  requires URL params (fixture, date, time, zone) to render meaningful
  content. Bare visits redirect to fixtures.html, so it would only ever
  cost crawl budget with no indexing value. It is also Disallow'd in
  robots.txt as a belt-and-braces measure.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://carbonfootball.uk/</loc>
    <priority>1.0</priority>
    <changefreq>weekly</changefreq>
  </url>
  <url>
    <loc>https://carbonfootball.uk/fixtures</loc>
    <priority>0.9</priority>
    <changefreq>daily</changefreq>
  </url>
  <url>
    <loc>https://carbonfootball.uk/zones</loc>
    <priority>0.8</priority>
    <changefreq>monthly</changefreq>
  </url>
</urlset>
